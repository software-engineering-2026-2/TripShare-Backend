# Development defaults only. Copy to .env; never commit real credentials.
POSTGRES_DB=mydatabase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SPRING_PORT=8080
APP_ENV=development
# Application only; migrations do not need Firebase credentials.
# Local JVM: export FIREBASE_KEY_PATH=file:/absolute/path/to/firebase.json
# Docker: provide the host path to the JSON service account (read-only mount).
FIREBASE_CREDENTIALS_FILE=./.secrets/firebase.json
FIREBASE_KEY_PATH=./.secrets/firebase.json
