# Development defaults only. Copy to .env; never commit real credentials.
POSTGRES_DB=mydatabase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SPRING_PORT=8080
APP_ENV=development
# Application only; migrations do not need Firebase credentials.
# Local JVM (run from trip.share/): defaults to file:../.secrets/firebase.json.
# Optional override: FIREBASE_KEY_PATH=file:/absolute/path/to/firebase.json
# Docker: provide the host path to the JSON service account (read-only mount).
FIREBASE_CREDENTIALS_FILE=./.secrets/firebase.json
FIREBASE_KEY_PATH=./.secrets/firebase.json
# Local browser/session settings. Set Secure=true and HTTPS in production.
APP_AUTH_BEARER_FALLBACK_ENABLED=true
APP_AUTH_COOKIE_NAME=tripshare_session
APP_AUTH_COOKIE_MAX_AGE=5d
APP_AUTH_COOKIE_SECURE=false
APP_AUTH_COOKIE_SAME_SITE=Lax
APP_AUTH_COOKIE_DOMAIN=
APP_AUTH_COOKIE_CHECK_REVOKED=true
