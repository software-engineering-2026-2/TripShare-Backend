# Development defaults only. Copy to .env; never commit real credentials.
POSTGRES_DB=mydatabase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SPRING_PORT=8080
APP_ENV=development
# A aplicação Java exige estas variáveis exportadas; Maven não carrega .env automaticamente.
FIREBASE_KEY_PATH=file:/absolute/path/firebase-service-account.json
FIREBASE_WEB_API_KEY=replace-with-your-project-web-api-key
APP_AUTH_SESSION_TTL=PT8H
# Caminho no host usado somente pelo Compose para montar a credencial no container spring.
FIREBASE_CREDENTIALS_FILE=/absolute/path/firebase-service-account.json
